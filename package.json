{
  "name": "ember-almanac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "api": "node --env-file-if-exists=.env server/main.ts",
    "data:fetch": "node pipeline/fetch-firms.mjs",
    "data:recent": "node --env-file-if-exists=.env pipeline/fetch-recent.mjs",
    "data:pack": "node pipeline/pack.mjs && node pipeline/boundaries.mjs && node pipeline/summarize.ts",
    "data": "npm run data:fetch && npm run data:recent && npm run data:pack"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^2.1.8",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "gsap": "^3.15.1",
    "hono": "^4.13.18",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
