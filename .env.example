# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/ . Server-side only: never commit it.
FIRMS_MAP_KEY=
PORT=8787
# Ground reports from the phone app (SQLite + photos). Defaults to ./storage.
STORAGE_DIR=
# Requests per client per 10 minutes across the API, and new reports per client per hour.
RATE_LIMIT_PER_10_MIN=1200
REPORTS_PER_HOUR=30
# Password for the /admin moderation page (report review). Empty turns /admin off.
ADMIN_PASSWORD=
# Escape routes. Optional free key from https://openrouteservice.org/dev/#/signup lets
# routes go around the fire directly; without it the server picks the safest of OSRM's routes.
ORS_API_KEY=
# Route requests per client per 10 minutes.
ESCAPES_PER_10_MIN=40
# Push alerts (Firebase Cloud Messaging). The service account key file's JSON, or that
# JSON base64-encoded. Server-side only: never commit the key file. Empty turns push off.
FIREBASE_SERVICE_ACCOUNT=
